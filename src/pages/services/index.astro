---
import { ArrowRight } from '@lucide/astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CtaBand from '../../components/CtaBand.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import FacebookVideo from '../../components/FacebookVideo.astro'
import Faq from '../../components/Faq.astro'
import Img from '../../components/Img.astro'
import Rule from '../../components/Rule.astro'
import { services } from '../../data/services'
import { site } from '../../data/site'

const description = 'Interior and exterior home improvements, bathroom and basement projects, and custom holiday lighting from Leading Edge Finishings in Woodbury, NJ.'
---
<BaseLayout title={`Services — ${site.name}`} description={description}>
  <section class="border-b-2 border-ink bg-paper-2"><div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24"><Eyebrow>What we do</Eyebrow><h1 class="max-w-3xl text-[clamp(2.5rem,6vw,4.5rem)]">Home improvement, inside and out.</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-70">From a more inviting bathroom or basement to updates that refresh your home's exterior, Leading Edge Finishings helps South Jersey homeowners make their spaces feel more like their own. Seasonal custom holiday lighting is available, too.</p></div></section>
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24"><div class="grid gap-10 md:grid-cols-2">{services.map((service, i) => <article class="flex flex-col border-2 border-ink bg-chalk">{service.image ? <figure class="overflow-hidden border-b-2 border-ink"><Img src={service.image} alt={service.name} width={820} ratio={4 / 3} sizes="(max-width: 768px) 100vw, 46vw" className="h-full w-full object-cover" /></figure> : service.videoUrl ? <figure id="holiday-lighting-video" class="relative aspect-video overflow-hidden border-b-2 border-ink bg-spruce"><FacebookVideo url={service.videoUrl} title="Custom holiday lighting video from Leading Edge Finishings" /></figure> : null}<div class="flex flex-1 flex-col p-6 sm:p-8"><p class="font-mono text-sm text-ink-45">0{i + 1}</p><h2 class="mt-2 text-3xl sm:text-4xl">{service.name}</h2><Rule className="mt-5" /><p class="mt-5 flex-1 leading-relaxed text-ink-70">{service.blurb}</p><a href={`/services/${service.slug}`} class="group mt-7 inline-flex items-center gap-2 font-display font-bold text-ochre">More about this work<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" stroke-width={2.5} aria-hidden="true" /></a></div></article>)}</div></div>
  <section class="border-t-2 border-ink/10"><div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-24"><Faq /></div></section>
  <CtaBand heading="Have a project in mind?" body="Call or text the team to discuss what you are planning." />
</BaseLayout>