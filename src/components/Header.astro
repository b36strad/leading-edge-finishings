---
import { Menu, Phone, X } from '@lucide/astro'
import { nav, site } from '../data/site'

const currentPath = Astro.url.pathname
const isActive = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path)
---

<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper/92 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3.5 lg:px-8">
    <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} home`}>
      <img src="/leading-edge-finishing%20logo.jpg" alt="" class="h-12 w-12 shrink-0 object-contain mix-blend-multiply" width="48" height="48" decoding="async" />
      <span class="leading-none">
        <span class="block font-display text-[1.35rem] font-extrabold">Leading Edge Finishings</span>
        <span class="tag text-[0.58rem] text-ink-45">Home Improvement</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
      {nav.slice(0, 3).map((item) => (
        <a href={item.to} class:list={[
          'group relative font-display text-[0.95rem] font-semibold text-ink transition-colors hover:text-ochre',
          isActive(item.to) && 'text-ochre',
        ]} aria-current={isActive(item.to) ? 'page' : undefined}>
          {item.label}
          <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-ochre transition-all duration-200 group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class="hidden items-center gap-2 font-mono text-sm font-medium text-ink transition-colors hover:text-ochre md:flex">
        <Phone class="h-4 w-4" stroke-width={2.2} aria-hidden="true" />{site.phone}
      </a>
      <a href="/contact" class="hidden bg-ochre px-5 py-2.5 font-display text-sm font-bold text-chalk shadow-[3px_3px_0_0_var(--color-ink)] transition-all hover:-translate-y-0.5 hover:bg-ochre-bright hover:shadow-[5px_5px_0_0_var(--color-ink)] sm:block">Get a quote</a>
      <button type="button" data-menu-toggle class="border-2 border-ink p-2 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Menu data-menu-open class="h-5 w-5" aria-hidden="true" />
        <X data-menu-close class="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-mobile-menu hidden class="border-t border-ink/15 bg-paper-2 lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-2" aria-label="Mobile navigation">
      {nav.map((item) => (
        <a href={item.to} aria-current={isActive(item.to) ? 'page' : undefined} class="border-b border-ink/10 py-4 font-display text-xl font-bold last:border-0">{item.label}</a>
      ))}
      <a href={site.phoneHref} class="py-4 font-mono text-base text-ochre">{site.phone}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
  const openIcon = document.querySelector<SVGElement>('[data-menu-open]')
  const closeIcon = document.querySelector<SVGElement>('[data-menu-close]')

  toggle?.addEventListener('click', () => {
    if (!menu || !toggle) return
    const open = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
    menu.hidden = !open
    openIcon?.classList.toggle('hidden', open)
    closeIcon?.classList.toggle('hidden', !open)
  })
</script>