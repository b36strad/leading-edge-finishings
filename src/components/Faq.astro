---
import { Plus } from '@lucide/astro'
import { faqs } from '../data/site'
import Eyebrow from './Eyebrow.astro'

interface Props { limit?: number }
const { limit } = Astro.props
const items = limit ? faqs.slice(0, limit) : faqs
---
<div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
  <div>
    <Eyebrow>Straight answers</Eyebrow>
    <h2 class="text-4xl sm:text-5xl">A few useful <span class="ruled">details</span></h2>
    <p class="mt-5 max-w-sm leading-relaxed text-ink-70">Company information sourced from the public profile.</p>
  </div>
  <div class="divide-y-2 divide-ink/10 border-y-2 border-ink/10">
    {items.map((faq) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6">
          <h3 class="font-display text-xl font-bold leading-snug group-open:text-ochre">{faq.q}</h3>
          <Plus class="mt-1 h-5 w-5 shrink-0 text-ochre transition-transform duration-300 group-open:rotate-45" stroke-width={2.5} aria-hidden="true" />
        </summary>
        <p class="mt-3 max-w-2xl pr-10 leading-relaxed text-ink-70">{faq.a}</p>
      </details>
    ))}
  </div>
</div>