---
interface Props {
  src: string
  alt: string
  width: number
  ratio?: number
  className?: string
  priority?: boolean
  sizes?: string
}

const { src, alt, width, ratio, className = '', priority = false, sizes = `${width}px` } = Astro.props
---

<img
  src={src}
  sizes={sizes}
  alt={alt}
  width={width}
  height={ratio ? Math.round(width / ratio) : undefined}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
/>