---
import { ArrowRight } from '@lucide/astro'
import { services } from '../data/services'
import { site } from '../data/site'

interface Props { preselect?: string }
const { preselect = '' } = Astro.props
const budgets = ['Under $15,000', '$15,000 – $30,000', '$30,000 – $60,000', '$60,000 – $120,000', 'Over $120,000', 'No idea yet — help me scope it']
const timelines = ['As soon as you can', 'Next 1 – 3 months', '3 – 6 months out', 'Planning for next year']
const labelClass = 'tag mb-2 block text-ink-45'
const fieldClass = 'w-full border-2 border-ink/20 bg-chalk px-4 py-3 font-body text-[0.95rem] text-ink transition-colors placeholder:text-ink-45/60 hover:border-ink/40 focus:border-ochre focus:outline-none'
---

<form data-quote-form action="/send-inquiry.php" method="post" novalidate class="border-2 border-ink bg-chalk p-6 shadow-lift sm:p-9">
  <div class="grid gap-5 sm:grid-cols-2">
    <div><label for="name" class={labelClass}>Your name</label><input class={fieldClass} id="name" name="name" required minlength="2" autocomplete="name" placeholder="Your name" /><p data-error-for="name" hidden class="mt-1.5 font-mono text-xs text-ochre">Tell us who to ask for.</p></div>
    <div><label for="email" class={labelClass}>Email</label><input class={fieldClass} id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" /><p data-error-for="email" hidden class="mt-1.5 font-mono text-xs text-ochre">We need a working email for the proposal.</p></div>
    <div><label for="phone" class={labelClass}>Phone</label><input class={fieldClass} id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="Your phone number" /><p data-error-for="phone" hidden class="mt-1.5 font-mono text-xs text-ochre">Enter a phone number with at least ten digits.</p></div>
    <div><label for="town" class={labelClass}>City or town</label><input class={fieldClass} id="town" name="town" required list="service-towns" autocomplete="address-level2" placeholder="Woodbury, NJ" /><datalist id="service-towns">{site.serviceArea.map((town) => <option value={town} />)}</datalist><p data-error-for="town" hidden class="mt-1.5 font-mono text-xs text-ochre">Where is the project located?</p></div>
    <div><label for="project" class={labelClass}>What kind of project</label><select class={fieldClass} id="project" name="project" required><option value="">Choose one…</option>{services.map((service) => <option value={service.name} selected={preselect === service.name}>{service.name}</option>)}<option value="Something else">Something else</option></select><p data-error-for="project" hidden class="mt-1.5 font-mono text-xs text-ochre">Pick the closest match.</p></div>
    <div><label for="budget" class={labelClass}>Budget you have in mind <span class="ml-2 normal-case tracking-normal text-ink-45/70">(optional)</span></label><select class={fieldClass} id="budget" name="budget"><option value="">Prefer not to say</option>{budgets.map((budget) => <option value={budget}>{budget}</option>)}</select></div>
    <div><label for="timeline" class={labelClass}>Timeline <span class="ml-2 normal-case tracking-normal text-ink-45/70">(optional)</span></label><select class={fieldClass} id="timeline" name="timeline"><option value="">Not sure yet</option>{timelines.map((timeline) => <option value={timeline}>{timeline}</option>)}</select></div>
    <div><label for="referral" class={labelClass}>How did you hear about us <span class="ml-2 normal-case tracking-normal text-ink-45/70">(optional)</span></label><input class={fieldClass} id="referral" name="referral" placeholder="Neighbor, drove past a job, search…" /></div>
  </div>
  <div class="mt-5"><label for="details" class={labelClass}>Tell us about the project</label><textarea class={`${fieldClass} min-h-36 resize-y`} id="details" name="details" required minlength="12" placeholder="Age of the house, what is bothering you, what you have already tried, and anything you have already picked out."></textarea><p data-error-for="details" hidden class="mt-1.5 font-mono text-xs text-ochre">A sentence or two about the project helps us quote it.</p></div>
  <button type="submit" class="group mt-7 inline-flex w-full items-center justify-center gap-2.5 bg-ochre px-8 py-4 font-display text-lg font-bold text-chalk shadow-[4px_4px_0_0_var(--color-ink)] transition-all hover:-translate-y-0.5 hover:bg-ochre-bright hover:shadow-[6px_6px_0_0_var(--color-ink)] disabled:cursor-wait disabled:opacity-70 sm:w-auto">
    <span>Send project request <ArrowRight class="h-5 w-5 transition-transform group-hover:translate-x-1" stroke-width={2.5} aria-hidden="true" /></span>
  </button>
  <p class="mt-4 font-mono text-xs text-ink-45">Your details will be used to respond to this project request.</p>
  <p data-form-status hidden role="status" aria-live="polite" class="mt-4 border-l-4 border-spruce bg-spruce/10 px-4 py-3 text-sm text-ink"><span data-form-status-message></span> <a data-form-fallback hidden class="underline" href={`mailto:${site.email}`}>Email us instead.</a></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')
    const statusMessage = form.querySelector<HTMLElement>('[data-form-status-message]')
    const fallbackLink = form.querySelector<HTMLElement>('[data-form-fallback]')
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (status) status.hidden = true
      const data = new FormData(form)
      const values = Object.fromEntries(data.entries())
      const errors: Record<string, boolean> = {
        name: String(values.name ?? '').trim().length < 2,
        email: !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(values.email ?? '')),
        phone: String(values.phone ?? '').replace(/\D/g, '').length < 10,
        town: !String(values.town ?? '').trim(),
        project: !String(values.project ?? ''),
        details: String(values.details ?? '').trim().length < 12,
      }
      Object.entries(errors).forEach(([name, invalid]) => {
        const field = form.elements.namedItem(name)
        const message = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)
        if (field instanceof HTMLElement) {
          field.setAttribute('aria-invalid', String(invalid))
        }
        if (message) message.hidden = !invalid
      })
      const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]')
      if (firstInvalid) {
        firstInvalid.focus()
        return
      }

      if (submitButton) submitButton.disabled = true
      if (status) status.hidden = false
      if (statusMessage) statusMessage.textContent = 'Sending your request…'
      if (fallbackLink) fallbackLink.hidden = true

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        })
        const result = await response.json() as { success?: boolean; message?: string }
        if (!response.ok || !result.success) {
          throw new Error(result.message || 'We could not send your request right now.')
        }
        if (statusMessage) statusMessage.textContent = result.message || 'Your request was sent.'
        form.reset()
      } catch {
        if (statusMessage) statusMessage.textContent = 'We could not send your request. Please try again or '
        if (fallbackLink) fallbackLink.hidden = false
      } finally {
        if (submitButton) submitButton.disabled = false
      }
    })
  })
</script>