---
import { Mail, MapPin, Phone } from '@lucide/astro'
import { nav, site } from '../data/site'
import { services } from '../data/services'
---

<footer class="border-t-2 border-ink bg-spruce text-paper">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.1fr]">
      <div>
        <p class="font-display text-2xl font-extrabold">{site.name}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-paper-3">{site.tagline}</p>
        <p class="tag mt-6 text-paper-3">{site.license} &middot; Est. {site.founded}</p>
      </div>
      <div>
        <p class="tag mb-4 text-ochre-bright">Services</p>
        <ul class="space-y-2.5 text-sm">
          {services.map((service) => <li><a href={`/services/${service.slug}`} class="text-paper-3 transition-colors hover:text-paper">{service.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="tag mb-4 text-ochre-bright">Company</p>
        <ul class="space-y-2.5 text-sm">
          {nav.map((item) => <li><a href={item.to} class="text-paper-3 transition-colors hover:text-paper">{item.label}</a></li>)}
        </ul>
        <a href={site.facebookUrl} target="_blank" rel="noreferrer" class="mt-8 inline-flex text-sm text-paper-3 underline decoration-ochre-bright underline-offset-4 hover:text-paper">Facebook page</a>
      </div>
      <div class="space-y-4 text-sm">
        <a href={site.phoneHref} class="flex items-start gap-3 hover:text-ochre-bright"><Phone class="mt-0.5 h-4 w-4 shrink-0 text-ochre-bright" aria-hidden="true" /><span class="font-mono">{site.phone}</span></a>
        <a href={`mailto:${site.email}`} class="flex items-start gap-3 break-all hover:text-ochre-bright"><Mail class="mt-0.5 h-4 w-4 shrink-0 text-ochre-bright" aria-hidden="true" /><span class="font-mono text-xs">{site.email}</span></a>
        <p class="flex items-start gap-3 text-paper-3"><MapPin class="mt-0.5 h-4 w-4 shrink-0 text-ochre-bright" aria-hidden="true" /><span>{site.address}</span></p>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-3 border-t border-paper/15 pt-6 text-xs text-paper-3 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <p class="font-mono">Interior &amp; exterior home improvements</p>
    </div>
  </div>
</footer>